# PostgreSQL connection string. A database is required for transfer history and /api/health.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/link_to_cloud

# Canonical public origin for same-origin checks and OAuth callbacks.
# Required in production; use the local app URL in development and your HTTPS public origin in production.
APP_ORIGIN=http://localhost:3000

# Optional single-IP header overwritten by a trusted ingress (never enable if clients can set it directly).
# CLIENT_IP_HEADER=CF-Connecting-IP

# Generate a unique random value with at least 32 bytes for every production deployment.
# Example: openssl rand -base64 48
SESSION_SECRET=

# Optional GitHub OAuth application (PAT login remains available without OAuth).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Google OAuth web client; enable the Google Drive API and drive.file scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Microsoft Entra web application. Grant delegated User.Read and Files.ReadWrite permissions.
# Redirect URI: https://YOUR_HOST/api/auth/onedrive/callback
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Optional scoped Dropbox OAuth app. Enable account_info.read, files.content.write, and files.metadata.read.
# Redirect URI: https://YOUR_HOST/api/auth/dropbox/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Optional comma-separated, operator-installed CommonJS provider packages. These are trusted server code,
# never user-uploaded plugins; include each package in the deployed image/node_modules.
# LINK_TO_CLOUD_PROVIDER_MODULES=@your-org/link-to-cloud-webdav


# Optional authenticated source-fetch relay. Configure both values or neither.
# RELAY_URL points to a deployed /relay endpoint (Cloudflare Worker or Netlify Function).
# Use the same random 32+ character secret in the app and the relay platform's secret store.
RELAY_URL=
RELAY_SHARED_SECRET=
